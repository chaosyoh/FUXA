{
  "Migration": {
    // FUXA server _appdata directory path containing SQLite databases
    // Windows:  "C:\\path\\to\\fuxa\\server\\_appdata"
    // Linux:    "/opt/fuxa/server/_appdata"
    // Docker:   "/usr/src/app/FUXA/server/_appdata"
    "AppdataDir": "C:\\path\\to\\fuxa\\server\\_appdata",

    // Migration mode:
    //   "preview"  - scan and show summary only (default)
    //   "dry-run"  - preview migration plan without writing data
    //   "run"      - execute migration
    "Mode": "preview",

    // Batch size for large inserts
    "BatchSize": 1000,

    // Include DAQ time-series data migration
    "IncludeDaq": false,

    // Truncate target tables before insert
    "Truncate": true,

    // Specific databases to migrate (empty = all)
    // e.g. ["project", "users", "alarms"]
    "Databases": []
  },
  "Target": {
    // Database type: "MySql" or "SqlServer"
    "DbType": "MySql",
    "Host": "localhost",
    "Port": 3306,
    "User": "root",
    "Password": "your_password",
    "Database": "fuxa",
    // SQL Server specific options (ignored for MySQL)
    "Encrypt": false,
    "TrustServerCertificate": true
  }
}
